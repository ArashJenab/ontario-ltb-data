# Downloaded LTB order PDFs — regenerated on demand by extract_amounts.py,
# hundreds of documents / potentially several GB, not suitable for git.
pdfs/

# Raw pre-simplification boundary downloads (~95MB each) — regenerated on
# demand by fetch_fsa_boundaries.py / fetch_csd_boundaries.py; only the
# simplified data/ontario_*_simplified.geojson output is kept in the repo.
data/raw_fsa_boundaries/
data/raw_csd_boundaries/

# Local archive of every fetch_ltb_orders.py run (gzipped, last 5 kept) — a
# safety net against upstream changes/removals, not a durable multi-machine
# backup. fetch_log.csv (the audit trail of decisions) IS tracked in git.
data/snapshots/

# Build artifacts / scratch outputs — the final map is committed at /map.html;
# scripts/_build/ is just the intermediate working copy the build script writes.
scripts/_build/

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/

# OS cruft
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# Raw Census Profile download (~68MB zipped, all of Canada) — regenerated on
# demand by fetch_fsa_census_profile.py; only the Ontario extract
# data/fsa_census_profile.csv is kept in the repo.
data/raw_statcan_98401X2021013/

# Layout-check screenshots from scripts/check_pages.py — regenerated on demand,
# and full-page renders of every page in both themes add up quickly.
docs/checks/
